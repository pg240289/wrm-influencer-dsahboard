# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production

# Email Configuration (for sending welcome emails to new users)
# Gmail Example:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Note: For Gmail, you need to use an "App Password" not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
#
# Leave MAIL_USERNAME empty to disable email functionality
# When disabled, generated passwords will be shown in the API response instead

# ============================================================
# Social Media Metrics Service Configuration
# ============================================================
# These API keys are required for the social_metrics_service.py
# to fetch engagement metrics (likes, views, comments) from posts

# YouTube Data API v3
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=

# Instagram Graph API (via Facebook Graph API)
# Requires Facebook Developer account and Instagram Business/Creator account
# Get token from: https://developers.facebook.com/tools/explorer/
# Required permissions: instagram_basic, instagram_manage_insights, pages_show_list
#
# To get your Instagram Business Account ID:
# 1. Get a Page Access Token for your Facebook Page linked to Instagram
# 2. Call: GET /me/accounts?fields=instagram_business_account
# 3. The instagram_business_account.id is your INSTAGRAM_BUSINESS_ACCOUNT_ID
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook Graph API
# Get token from: https://developers.facebook.com/tools/explorer/
# Required permissions: pages_read_engagement, pages_show_list
FACEBOOK_ACCESS_TOKEN=

# LinkedIn API
# Requires LinkedIn Developer account
# Get token from: https://www.linkedin.com/developers/
# Required permissions: r_organization_social, rw_organization_admin (for page analytics)
LINKEDIN_ACCESS_TOKEN=
